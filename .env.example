# ============================================================
# DSH Self-evolving Agent —— 环境变量模板（示例）
# 本文件可安全提交进版本库（不含任何真实密钥）。
# 真实密钥请放在本地 .env（已被 .gitignore 忽略，严禁提交）。
# ============================================================

# ---- 运行时配置（代码实际读取）----
# SQLite 数据库路径（plugins/dsh-self-evolving-agent/src/index.ts 读取 SELF_EVOLVING_DB）
SELF_EVOLVING_DB=./data/self_evolving.db

# 开发模式开关（scripts/serve.py 读取 DSH_DEV / SELF_EVOLVING_DEV）
DSH_DEV=0
SELF_EVOLVING_DEV=0

# ---- 发布 / Release 凭证（仅本地 .env 填写；CI 用密钥库注入，绝不入仓）----
# npm 发布令牌（用于 npm publish @kiwifruit/dsh-self-evolving-agent）
NPM_TOKEN=__REPLACE_WITH_YOUR_NPM_TOKEN__

# GitHub 个人访问令牌（用于创建 GitHub Release）
GITHUB_TOKEN=__REPLACE_WITH_YOUR_GITHUB_PAT__
