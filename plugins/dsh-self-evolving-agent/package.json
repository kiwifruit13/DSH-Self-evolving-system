{
  "name": "@kiwifruit/dsh-self-evolving-agent",
  "version": "0.3.0-rc.1",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "cordis-plugin",
    "self-evolving",
    "agent",
    "routing-table",
    "ai-agent"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/",
    "scripts/",
    "pycore/",
    "cordis.patch.yml",
    "!**/*.pyc",
    "!**/__pycache__/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node scripts/prepare-pycore.mjs",
    "version:gen": "bash ../../git-version.sh",
    "release:set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@kiwifruit/dsh-self-evolving-contract": "link:../dsh-self-evolving-contract"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0"
  }
}
